# ============================================================
# PIPE-SOGI — .gitignore
# ============================================================

# --- Python ---------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.Python
build/
dist/

# --- virtual environments -------------------------------------
.venv/
venv/
env/

# --- Jupyter ---------------------------------------------------
.ipynb_checkpoints/
*.nbconvert.ipynb

# --- IDE / OS --------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# --- training / tuning artifacts (regenerated by the pipeline) --
darts_logs/
lightning_logs/
*.ckpt
*.pth
optuna*.db

# --- intermediate checkpoints (large, regenerable) --------------
result/v2p_ckpt_*.xlsx
result/v2_ckpt_*.xlsx

# --- keep these (do NOT ignore): -------------------------------
# result/v2p_hp_*.xlsx          -> tuned hyperparameters (reproducibility)
# result/v2p_result_steel_*.xlsx-> forecasts, residuals, native quantiles
# result/v2p_var_fri*.xlsx      -> risk-layer results
# result/*.png                  -> figures used in the paper
